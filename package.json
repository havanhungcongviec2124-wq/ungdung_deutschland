{
  "name": "flashcard-cloud",
  "private": true,
  "version": "1.0.0",
  "description": "Ứng dụng flashcard WortKarte cho web và macOS.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "desktop:run": "npm run build && electron .",
    "desktop:mac": "npm run build && electron-builder --mac dmg --x64 --arm64"
  },
  "build": {
    "appId": "vn.wortkarte.flashcards",
    "productName": "WortKarte",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@tailwindcss/vite": "^4.1.13",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.0.12",
    "tailwindcss": "^4.1.13",
    "vite": "^6.3.5",
    "wrangler": "^4.158.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
